APP_MODE=local
API_TIMEOUT_SECONDS=30

LLM_PROVIDER=mock
LLM_MODEL=mock-llm

RERANKER_PROVIDER=mock
RERANKER_MODEL=mock-reranker

ASR_PROVIDER=mock
ASR_MODEL=mock-asr

VISION_PROVIDER=mock
VISION_MODEL=mock-vision

INTENT_PLANNER_PROVIDER=mock
INTENT_PLANNER_BASE_URL=https://api.siliconflow.cn/v1
INTENT_PLANNER_MODEL=mock-intent-planner
INTENT_PLANNER_TEMPERATURE=0
INTENT_PLANNER_MAX_TOKENS=800

OPENAI_API_KEY=xxx
SILICONFLOW_API_KEY=xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
ANTHROPIC_API_KEY=xxx

# Optional SiliconFlow API mode, copy to local .env and edit there only:
# APP_MODE=api
# LLM_PROVIDER=siliconflow
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# RERANKER_PROVIDER=siliconflow
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# VISION_PROVIDER=mock
# ASR_PROVIDER=mock
# SILICONFLOW_API_KEY=<your-local-key>

# Optional intent planner API mode. Keep mock for local/offline tests.
# INTENT_PLANNER_PROVIDER=siliconflow
# INTENT_PLANNER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# INTENT_PLANNER_BASE_URL=https://api.siliconflow.cn/v1

# Optional vision caption API mode:
# VISION_PROVIDER=siliconflow
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# Real ASR is not wired in M7. Keep ASR mock until SiliconFlowASRClient exists.
# Future ASR model candidate:
# ASR_PROVIDER=mock
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
